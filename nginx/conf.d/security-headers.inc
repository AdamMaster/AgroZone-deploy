# Общие защитные HTTP-заголовки. Подключаются через include в оба HTTPS-блока
# (см. app.conf) — один источник правды вместо копии в каждом server{}.
#
# Расширение .inc, а не .conf, намеренно: nginx сам подхватывает из conf.d
# только *.conf, и будь тут .conf — файл попал бы в контекст http и применился
# ко всем серверам разом, включая 80-е редиректные блоки. HSTS на HTTP-ответе
# браузер всё равно игнорирует, так что честнее подключать явно и только там,
# где TLS.
#
# ВАЖНО про поведение nginx: add_header наследуется в дочерний контекст только
# если в нём НЕТ собственных add_header. Если однажды добавишь add_header
# внутрь какого-нибудь location — все заголовки отсюда в этом location молча
# исчезнут; тогда нужно продублировать include прямо в нём.
#
# always у каждого заголовка — чтобы они уходили и с ошибочными ответами
# (4xx/5xx), а не только с успешными.

# Год. Браузер, однажды увидевший этот заголовок, дальше сам переписывает
# http:// на https:// и не даёт проскочить «продолжить» на битом сертификате —
# именно это закрывает даунгрейд при заходе по ссылке без схемы.
# includeSubDomains накрывает и api.agro-zone.ru — он уже под TLS.
# preload намеренно НЕ добавлен: сам по себе он ничего не делает, пока домен не
# подан в hstspreload.org, а после подачи удалить домен из списка практически
# невозможно — любой будущий поддомен без TLS окажется недоступен.
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

# Запрещает браузеру угадывать тип содержимого вопреки Content-Type. Закрывает
# класс атак, где файл, загруженный «как картинка», исполняется как скрипт.
add_header X-Content-Type-Options "nosniff" always;

# Сайт нельзя встроить во фрейм. Для площадки это прежде всего про кликджекинг
# на кнопках «Показать телефон» и на форме входа: невидимый фрейм поверх чужой
# страницы — и человек нажимает наши кнопки, не подозревая об этом.
add_header X-Frame-Options "DENY" always;

# При переходе на сторонний сайт в Referer уходит только origin, без пути и
# параметров — чтобы адреса конкретных объявлений и поисковые запросы не
# утекали в аналитику чужих сайтов.
add_header Referrer-Policy "strict-origin-when-cross-origin" always;

# Явно отключаем то, что сайту не нужно. geolocation оставлен для себя — он
# может понадобиться, когда будем определять регион посетителя (см. U9 в
# ROADMAP.md).
add_header Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)" always;
