# Скопируйте в .env (он в .gitignore корня репозитория) для локального запуска.
# Переменные EXPO_PUBLIC_* встраиваются в бандл приложения и видны любому, кто
# его распакует, — секретов здесь быть не должно. В облачных сборках EAS
# значения берутся из eas.json (env у каждого профиля).
EXPO_PUBLIC_API_URL=https://api.agro-zone.ru
EXPO_PUBLIC_SITE_URL=https://agro-zone.ru
# Публичный ключ Яндекс SmartCaptcha — тот же, что NEXT_PUBLIC_YANDEX_CAPTCHA_CLIENT_KEY у сайта.
EXPO_PUBLIC_YANDEX_CAPTCHA_SITEKEY=
