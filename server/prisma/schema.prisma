generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id          String      @id @default(uuid())
  phones      UserPhone[]
  password    String?
  email       String?     @unique
  displayName String?     @map("display_name")
  picture     String?

  type     UserType @default(INDIVIDUAL)
  bio      String?  @db.Text
  location String?

  // Факт подтверждения ИП/компании через ИНН (DaData) — заполняются только
  // после успешной проверки в UserService.verifyBusiness, никогда напрямую
  // из формы настроек. businessName — готовое к показу название из ответа
  // DaData (например "ИП Иванов И.И." или "ООО РОМАШКА"), businessInn —
  // ИНН, по которому проверка проходила (может отличаться от текущего, если
  // пользователь позже сменил тип продавца вручную — см.
  // UserService.update). businessVerifiedAt — null, пока не подтверждено.
  businessInn        String?   @map("business_inn")
  businessName       String?   @map("business_name")
  businessVerifiedAt DateTime? @map("business_verified_at")

  // Презентация компании — один документ (прайс-лист/каталог/описание
  // компании), который продавец прикладывает к своему профилю (см.
  // обсуждение с пользователем: аналог фичи "Размещение файлов в товарах"
  // у agroserver.ru, но на уровне профиля продавца, а не объявления —
  // прайс общий для всех лотов, незачем грузить его на каждое объявление
  // заново). Один файл, а не таблица вложений — сознательный выбор для
  // MVP: закрывает основной сценарий "прайс + о компании" простой схемой;
  // если понадобится несколько документов — мигрируется на отдельную
  // таблицу без потери текущих данных (это поле станет первой записью).
  // presentationFileName — оригинальное имя файла, как у пользователя (S3
  // хранит его под сгенерированным именем, см. FileService.uploadFile),
  // нужно, чтобы показать "Прайс-лист_2026.pdf", а не голую ссылку.
  // presentationFileSize — байты, для отображения размера рядом с именем
  // на фронте, не участвует в проверке лимита (лимит проверяется на
  // бэкенде в момент загрузки, см. UserController.updatePresentation).
  presentationUrl      String? @map("presentation_url")
  presentationFileName String? @map("presentation_file_name")
  presentationFileSize Int?    @map("presentation_file_size")

  role UserRole @default(REGULAR)

  premiumUntil DateTime? @map("premium_until")

  isVerified         Boolean @default(false) @map("is_verified")
  isTwoFactorEnabled Boolean @default(false) @map("is_two_factor_enabled")

  // Письма о новых сообщениях в чате (см. ChatEmailRemindersService): включены
  // по умолчанию, пользователь отключает их в настройках. Служебные письма
  // (сброс пароля, подтверждение почты, решения модерации) этим флагом не
  // управляются и приходят всегда.
  chatEmailNotifications Boolean @default(true) @map("chat_email_notifications")

  // Момент, когда пользователь дал согласие на обработку персональных
  // данных (152-ФЗ) — проставляется при регистрации (чекбокс на форме email
  // /SMS-регистрации, обязателен к отметке; для OAuth-регистрации согласие
  // подразумевается уведомлением рядом с кнопками Google/Яндекс на форме,
  // см. AuthFormWrapper). null означает, что согласие не зафиксировано
  // (не должно происходить для новых аккаунтов после этого изменения).
  personalDataConsentAt DateTime? @map("personal_data_consent_at")

  // Неизменяемый журнал самих фактов согласия — в отличие от поля выше
  // (которое отвечает только на вопрос "согласие есть?" и удобно для
  // быстрых проверок), здесь хранится с каким именно IP, User-Agent и
  // версией документа (см. PERSONAL_DATA_CONSENT_DOCUMENT_VERSION в
  // server/src/libs/common/constants/legal.constants.ts) согласие было
  // дано — это и есть юридически значимое доказательство по 152-ФЗ, и оно
  // не должно перезаписываться при повторной регистрации/восстановлении
  // аккаунта, поэтому отдельная append-only таблица, а не колонки в User.
  personalDataConsents PersonalDataConsent[]

  securityEvents UserSecurityEvent[]

  registrationAttempts RegistrationAttempt[]
  pushDevices          PushDevice[]
  chatEmailReminders   ChatEmailReminder[]

  deletedAt DateTime? @map("deleted_at")

  method   AuthMethod
  accounts Account[]
  tokens   Token[]

  ads       Ad[]
  favorites Favorite[]

  conversationsAsBuyer  Conversation[] @relation("ConversationsAsBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationsAsSeller")
  sentMessages          Message[]

  // Гости чата поддержки, чья переписка "приклеилась" к этому аккаунту
  // после того, как они зарегистрировались/залогинились (см.
  // SupportGuest.mergedIntoUserId и ConversationsService.mergeGuestOnLogin).
  mergedSupportGuests SupportGuest[]

  blockedUsers   BlockedUser[] @relation("BlockerOf")
  blockedByUsers BlockedUser[] @relation("BlockedBy")

  adReports AdReport[]

  adBumps AdBump[]

  premiumPurchases PremiumPurchase[]

  adServicePurchases AdServicePurchase[]

  // Дилерский фид — см. DealerFeed. Один аккаунт = один фид (см. комментарий
  // у модели), поэтому связь 1:1, а не массив.
  dealerFeed DealerFeed?

  dealerSubscriptions DealerSubscription[]

  notifications Notification[]

  // Показы телефонов: те, что этот пользователь открывал, и те, что
  // открывали у него — см. AdPhoneReveal.
  phoneRevealsMade     AdPhoneReveal[] @relation("PhoneRevealViewer")
  phoneRevealsReceived AdPhoneReveal[] @relation("PhoneRevealSeller")

  // Кто из администраторов менял настройки сайта — см. SiteSetting.
  siteSettingsUpdated SiteSetting[]
  siteSettingChanges  SiteSettingChange[]

  // Отзывы о продавце: полученные и написанные этим пользователем — см.
  // SellerReview.
  sellerReviewsReceived SellerReview[] @relation("SellerReviewSeller")
  sellerReviewsWritten  SellerReview[] @relation("SellerReviewAuthor")

  // Модерация отзывов: кто из администраторов принял решение по отзыву и
  // чьи жалобы на отзывы есть в очереди — см. SellerReviewReport.
  sellerReviewsModerated SellerReview[]       @relation("SellerReviewModerator")
  sellerReviewReports    SellerReviewReport[] @relation("SellerReviewReporter")

  // Жалобы на мошенничество: поданные на этого пользователя как на продавца и
  // им самим, а также меры модераторов — см. SellerReport, SellerSanction.
  sellerReportsReceived SellerReport[]   @relation("SellerReportSeller")
  sellerReportsMade     SellerReport[]   @relation("SellerReportReporter")
  sellerSanctions       SellerSanction[] @relation("SellerSanctionSeller")
  sellerSanctionsIssued SellerSanction[] @relation("SellerSanctionModerator")

  // Рейтинг продавца — денормализованный результат по опубликованным
  // отзывам, чтобы карточки и профили не считали его на лету. Пересчитывается
  // только в SellerRatingService.recalculate, больше нигде не пишется.
  // ratingAverage — взвешенное среднее (вес у каждого отзыва свой, см.
  // SellerReview.weight), null пока нет ни одного отзыва; ratingCount —
  // число опубликованных отзывов (не сумма весов).
  ratingAverage Float? @map("rating_average")
  ratingCount   Int    @default(0) @map("rating_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model PersonalDataConsent {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ip        String
  userAgent String? @map("user_agent")

  // Дата документов (Политика конфиденциальности + Пользовательское
  // соглашение), с которыми пользователь согласился в момент фиксации —
  // см. PERSONAL_DATA_CONSENT_DOCUMENT_VERSION на сервере и
  // LEGAL_DETAILS.effectiveDate на клиенте (должны обновляться синхронно).
  documentVersion String @map("document_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("personal_data_consents")
}

// Тип события в журнале безопасности аккаунта (см. UserSecurityEvent).
// Набор намеренно узкий: только то, что меняет доступ к аккаунту или его
// контактные данные, — это журнал для расследования ("мне сменили пароль,
// я ничего не делал"), а не аналитика поведения. Не добавляйте сюда
// просмотры страниц, поиск и прочие события, не влияющие на безопасность.
enum SecurityEventType {
  ACCOUNT_REGISTERED
  ACCOUNT_CREATED_BY_ADMIN
  ACCOUNT_DELETED
  LOGIN_NEW_DEVICE
  PASSWORD_CHANGED
  PASSWORD_RESET
  PASSWORD_SET_BY_ADMIN
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGED
  EMAIL_SET_BY_ADMIN
  PHONE_ADDED
  PHONE_CHANGED
  PRIMARY_PHONE_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  OAUTH_LINKED
  ROLE_CHANGED
  PREMIUM_SET_BY_ADMIN
}

// Кто совершил действие: сам владелец аккаунта (USER — в том числе по
// ссылке из письма), администратор (ADMIN — actorId указывает на него) или
// система без участия человека (SYSTEM — например, автоповышение роли по
// ADMIN_EMAILS, см. AuthService.ensureAdminRole).
enum SecurityEventActor {
  USER
  ADMIN
  SYSTEM
}

// Журнал событий безопасности аккаунта: смена пароля/email/телефона, 2FA,
// привязка соцсетей, вход с нового устройства/IP, действия администратора
// над аккаунтом. Пишется через SecurityEventsService.record() — он сам
// подтягивает IP/User-Agent из текущего запроса и определяет, кто актор.
//
// Что здесь НЕ хранится никогда: пароли и их хэши, коды из SMS/писем,
// токены. email и телефон в metadata лежат только в маскированном виде
// (см. mask.util.ts) — журнал не должен сам становиться вторым хранилищем
// персональных данных. Срок хранения ограничен (см.
// SECURITY_EVENTS_RETENTION_DAYS и SecurityEventsRetentionWorker): IP и
// устройство — персональные данные по 152-ФЗ, хранить их бессрочно нельзя.
//
// actorId — id администратора БЕЗ внешнего ключа: запись должна пережить
// возможное удаление/обезличивание аккаунта самого админа, а не сломаться
// из-за ссылочной целостности.
model UserSecurityEvent {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    SecurityEventType
  actor   SecurityEventActor @default(USER)
  actorId String?            @map("actor_id")

  ip        String?
  userAgent String? @map("user_agent")
  // Короткая подпись устройства, вычисленная из User-Agent при записи
  // ("Chrome · Windows") — чтобы не разбирать строку UA при каждом показе.
  device String?

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
  @@index([createdAt])
  @@map("user_security_events")
}

// Журнал попыток регистрации (админка → «Регистрации»): помогает увидеть,
// где люди застревают и не ломается ли регистрация (ошибка провайдера звонков
// или почты, не пришёл звонок, не открыли письмо). Одна запись — одна попытка
// зарегистрироваться по телефону или почте; шаги и ошибки внутри попытки
// обновляют ту же запись (RegistrationAttemptsService). Хранит телефон/почту
// и IP людей, которые могли так и не зарегистрироваться, поэтому срок
// хранения ограничен (REGISTRATION_ATTEMPTS_RETENTION_DAYS) и указан в
// политике конфиденциальности. userId — аккаунт, если регистрация завершилась.
model RegistrationAttempt {
  id String @id @default(uuid())

  channel  RegistrationChannel
  // Нормализованный телефон или email, с которого начали регистрацию.
  contact  String
  platform RegistrationPlatform @default(UNKNOWN)

  status RegistrationAttemptStatus @default(IN_PROGRESS)
  step   RegistrationAttemptStep   @default(STARTED)

  // Последняя ошибка на этой попытке; остаётся, даже если человек потом
  // продвинулся дальше — так видно, на чём он спотыкался.
  failureReason RegistrationFailureReason? @map("failure_reason")
  failureDetail String?                    @map("failure_detail")
  failuresCount Int                        @default(0) @map("failures_count")

  ip        String?
  userAgent String? @map("user_agent")
  device    String?

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@index([status, updatedAt(sort: Desc)])
  @@index([channel, contact, updatedAt(sort: Desc)])
  @@index([updatedAt])
  @@map("registration_attempts")
}

// Факт показа телефона продавца: покупатель нажал «Показать телефон» (см.
// AdsService.getPhone). Нужен системе отзывов: связаться с продавцом можно и
// звонком, мимо чата, — такой контакт тоже даёт право оставить отзыв (с
// меньшим весом, чем при подтверждённой сделке). Одна запись на пару
// «пользователь — объявление»: повторные показы того же номера по тому же
// объявлению не пишутся, createdAt остаётся временем ПЕРВОГО показа — от
// него считается выдержка до права на отзыв. Сам номер не хранится, ровно
// как и в журнале сервера.
//
// sellerId продублирован из объявления намеренно: объявление может быть
// физически удалено (adId тогда обнуляется, SetNull), а контакт с продавцом
// при этом был, и для отзывов нужен именно он, а не судьба объявления.
model AdPhoneReveal {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation("PhoneRevealViewer", fields: [userId], references: [id], onDelete: Cascade)

  sellerId String @map("seller_id")
  seller   User   @relation("PhoneRevealSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  adId String? @map("ad_id")
  ad   Ad?     @relation(fields: [adId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  // Дедуп повторных показов (createMany + skipDuplicates). У строк с
  // обнулённым adId (объявление удалено) уникальность не действует — в
  // Postgres NULL не равен NULL, а повторов такие строки и не порождают.
  @@unique([userId, adId])
  // «Когда этот пользователь впервые открыл телефон этого продавца».
  @@index([userId, sellerId, createdAt])
  @@index([sellerId])
  @@index([adId])
  @@map("ad_phone_reveals")
}

// Как у автора отзыва появилось право оценить продавца. DEAL_CONFIRMED —
// продавец сам отметил сделку состоявшейся в диалоге с этим покупателем
// (Conversation.dealConfirmedAt): отзыв получает значок «Сделка
// подтверждена» и полный вес. CONTACT — подтверждения нет, но контакт был
// (достаточная переписка либо показанный номер телефона и выдержка по
// времени): значок «Не подтверждено продавцом» и малый вес.
enum SellerReviewContactType {
  DEAL_CONFIRMED
  CONTACT
}

// PUBLISHED — виден всем и входит в рейтинг; HIDDEN — скрыт модератором;
// PENDING — ждёт решения модератора (сработал автофильтр или набралось
// достаточно жалоб): не виден никому, кроме автора, и в рейтинг не входит.
enum SellerReviewStatus {
  PUBLISHED
  HIDDEN
  PENDING
}

// Что насторожило автофильтр в тексте отзыва (см. review-text-filter.util).
// Хранится вместе с отзывом, чтобы модератор сразу видел причину, по
// которой тот попал в очередь.
enum SellerReviewFilterFlag {
  PROFANITY
  LINK
  PHONE
  REPEATED_TEXT
}

// Отзыв покупателя о продавце. Один отзыв на пару «автор — продавец»
// (@@unique): повторная оценка — это правка прежнего отзыва, а не новая
// запись, иначе рейтинг можно было бы накручивать числом отзывов.
//
// weight — вес отзыва в рейтинге БЕЗ учёта взаимности: базовый вес по
// contactType, умноженный на коэффициент доверия к автору (новый аккаунт без
// другой активности весит меньше). Взаимные отзывы (А оценил Б, Б оценил А)
// ослабляются при пересчёте рейтинга, а не записываются сюда, потому что
// зависят от чужого отзыва, который может появиться или исчезнуть позже —
// см. SellerRatingService.recalculate.
//
// conversationId — диалог, из которого возникло право на отзыв (nullable:
// право может дать и показанный телефон, а диалог — быть удалён).
// По отзыву с DEAL_CONFIRMED сделку в этом диалоге отменить нельзя.
model SellerReview {
  id String @id @default(uuid())

  sellerId String @map("seller_id")
  seller   User   @relation("SellerReviewSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation("SellerReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  contactType SellerReviewContactType @map("contact_type")

  // 1–5; границы дублирует CHECK в миграции.
  rating Int
  text   String? @db.Text
  weight Float

  status SellerReviewStatus @default(PUBLISHED)

  // Сработавшие правила автофильтра; пусто, если отзыв чистый. Непустое
  // значение при status = PENDING — причина, по которой отзыв ждёт модератора.
  filterFlags SellerReviewFilterFlag[] @default([]) @map("filter_flags")

  // Решение модератора. moderatedAt заполнено — отзыв уже рассмотрен: если
  // он оставлен опубликованным, новые жалобы, пришедшие до этого момента, его
  // повторно в очередь не возвращают (см. SellerReviewModerationService).
  // moderatedById — SetNull: удаление аккаунта модератора не должно
  // ломать отзыв.
  moderatedAt   DateTime? @map("moderated_at")
  moderatedById String?   @map("moderated_by_id")
  moderatedBy   User?     @relation("SellerReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  reports SellerReviewReport[]

  // Ответ продавца: один на отзыв, редактируется; sellerReplyAt — время
  // последнего сохранения ответа.
  sellerReply   String?   @map("seller_reply") @db.Text
  sellerReplyAt DateTime? @map("seller_reply_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([authorId, sellerId])
  // Список отзывов продавца и пересчёт его рейтинга.
  @@index([sellerId, status, createdAt])
  // Лимит отзывов в сутки на автора.
  @@index([authorId, createdAt])
  @@index([conversationId])
  // Очередь модератора: отзывы в ожидании решения.
  @@index([status, createdAt])
  @@map("seller_reviews")
}

enum SellerReviewReportReason {
  FAKE
  ABUSIVE
  SPAM
  PERSONAL_DATA
  OTHER
}

// PENDING — жалоба ещё не рассмотрена; ACCEPTED — модератор счёл её
// обоснованной (отзыв скрыт); DISMISSED — отклонена (отзыв оставлен).
enum SellerReviewReportStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

// Жалоба на отзыв о продавце. Одна жалоба от одного пользователя на отзыв
// (@@unique) — повтор не накручивает счётчик. Решение принимает модератор,
// автоматически только прячется из публичной выдачи сам отзыв при
// достаточном числе независимых жалоб (см. SELLER_REVIEW_REPORTS_TO_HIDE).
model SellerReviewReport {
  id String @id @default(uuid())

  reviewId String       @map("review_id")
  review   SellerReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reporterId String @map("reporter_id")
  reporter   User   @relation("SellerReviewReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reason  SellerReviewReportReason
  comment String?                  @db.Text
  status  SellerReviewReportStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reviewId, reporterId])
  @@index([reviewId, status])
  // Лимит жалоб в сутки на пользователя.
  @@index([reporterId, createdAt])
  @@map("seller_review_reports")
}

enum SellerReportReason {
  PREPAYMENT_SCAM
  FAKE_AD
  STOLEN_PHOTOS
  DIFFERENT_ITEM
  OTHER
}

// PENDING — ждёт решения модератора; ACCEPTED — признана обоснованной
// (продавцу вынесена мера); DISMISSED — отклонена.
enum SellerReportStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

// Жалоба на продавца: мошенничество, обман. Отдельный канал от отзывов — она
// не влияет на рейтинг, а работает на закономерности: решение по продавцу
// принимает модератор по совокупности жалоб, сигналов и истории аккаунта.
// Пожаловаться может только тот, кто контактировал с продавцом (диалог по его
// объявлению или показанный телефон) — иначе конкурент мог бы закидать
// жалобами любого. Одна жалоба от человека на продавца (@@unique).
model SellerReport {
  id String @id @default(uuid())

  sellerId String @map("seller_id")
  seller   User   @relation("SellerReportSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  reporterId String @map("reporter_id")
  reporter   User   @relation("SellerReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // Объявление, по которому произошёл обман; необязательно. SetNull: удаление
  // объявления не должно стирать жалобу.
  adId String? @map("ad_id")
  ad   Ad?     @relation(fields: [adId], references: [id], onDelete: SetNull)

  reason  SellerReportReason
  comment String?            @db.Text
  status  SellerReportStatus @default(PENDING)

  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@unique([sellerId, reporterId])
  // Нерассмотренные жалобы на продавца и их подсчёт.
  @@index([sellerId, status])
  // Лимит жалоб в сутки на человека.
  @@index([reporterId, createdAt])
  // Очередь модератора.
  @@index([status, createdAt])
  @@map("seller_reports")
}

enum SellerSanctionType {
  WARNING
  ADS_SUSPENDED
  ADS_RESTORED
  REVIEWS_HIDDEN
}

// Журнал мер по продавцу: что, когда и кем сделано. Нужен модератору в
// карточке продавца (история аккаунта) и как след для разбора споров.
// moderatorId пустой, если мера автоматическая (приостановка объявлений по
// числу жалоб) или аккаунт модератора удалён.
model SellerSanction {
  id String @id @default(uuid())

  sellerId String @map("seller_id")
  seller   User   @relation("SellerSanctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  moderatorId String? @map("moderator_id")
  moderator   User?   @relation("SellerSanctionModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  type SellerSanctionType
  note String?            @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sellerId, createdAt])
  @@map("seller_sanctions")
}

// Переключатели возможностей сайта и приложения (feature flags), которыми
// владелец управляет из админки без деплоя: например, выключенная до поры
// система рейтингов продавцов. Строка здесь — только ПЕРЕОПРЕДЕЛЕНИЕ: набор
// допустимых ключей и значение по умолчанию живут в коде
// (site-settings/constants/site-flags.constants.ts), поэтому флаг, которого
// в таблице ещё нет, просто имеет значение по умолчанию, а новый флаг не
// требует ни миграции, ни записи в базу. Читается через SiteSettingsService
// (кеш в Redis), напрямую из других модулей эту таблицу не читаем.
model SiteSetting {
  key   String  @id
  value Boolean

  // SetNull, а не Cascade: настройка не должна исчезать вместе с аккаунтом
  // администратора, который её последним менял.
  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// Журнал переключений: кто, что и когда включил или выключил. Дописывается
// только при реальной смене значения, записи не меняются и не удаляются —
// ответ на вопрос «почему вдруг пропала/появилась функция на сайте».
// Это не журнал безопасности аккаунта (см. UserSecurityEvent): у того узкий
// набор событий и ограниченный срок хранения, а здесь история действий
// администраторов над самим сайтом, и она небольшая по объёму.
model SiteSettingChange {
  id String @id @default(uuid())

  key   String
  // Значение, установленное этим изменением (прежнее — значение предыдущей
  // записи по тому же ключу).
  value Boolean

  changedById String? @map("changed_by_id")
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("site_setting_changes")
}

model UserPhone {
  id String @id @default(uuid())

  phone String @unique

  isPrimary Boolean @default(false)

  isVerified Boolean @default(false)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("user_phones")
}

model Account {
  id String @id @default(uuid())

  type              String
  provider          String
  providerAccountId String @map("provider_account_id")

  refreshToken String? @map("refresh_token")
  accessToken  String? @map("access_token")
  expiresAt    Int     @map("expires_at")

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Token {
  id String @id @default(uuid())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @map("user_id")

  phone     String?
  email     String?
  token     String
  type      TokenType
  expiresIn DateTime  @map("expires_in")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([token, type])
  @@index([phone, type])
  @@index([userId])
  @@index([token])
  @@map("tokens")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String? // 👈 Новое поле

  priceUnits PriceUnit[] @default([ITEM]) @map("price_units")

  slug     String
  path     String[] @default([])
  fullPath String   @unique @map("full_path")

  code String @unique

  iconId String? @map("icon_id")

  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryToCategory")

  level     Int @default(0)
  sortOrder Int @default(0)

  categoryFeatures CategoryFeature[]

  ads Ad[]

  // Раньше тут был один Float[] embedding на всю категорию (см. git-историю
  // и обсуждение с пользователем), посчитанный по name + всему description
  // разом. Это не сработало: description после обогащения через GigaChat —
  // это список из 15-25 обиходных названий/сортов ("ель обыкновенная, туя
  // западная, кедр сибирский, ..."), а mean pooling усредняет вклад каждого
  // слова в один вектор — "туя" в списке из 25 пород даёт вклад ~1/25, сигнал
  // тонет, и поиск по "туи" не находил "Саженцы хвойных пород", хотя туя
  // западная прямо была в описании. Заменили на CategoryTerm ниже — по
  // отдельному вектору на каждый термин, и берём максимум при поиске вместо
  // среднего (см. CategoriesService.searchBySemantic и
  // scripts/precompute-category-embeddings.ts).
  terms CategoryTerm[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([slug])
  @@index([fullPath])
  @@index([code])
  @@map("categories")
}

// Один термин (название категории ИЛИ одно слово/фраза-синоним из
// обогащённого description) — свой собственный эмбеддинг. Семантический
// поиск категории (CategoriesService.searchBySemantic) сравнивает запрос со
// ВСЕМИ терминами и берёт максимум по каждой категории — так запрос "туи"
// напрямую сравнивается с термином "туя западная", а не размывается
// усреднением с 24 другими соснами/елями в одном векторе категории (см.
// комментарий у Category.terms выше). Отдельная таблица, а не Float[][] в
// Category — сравнение остаётся плоским списком строк, дешевле для брутфорс
// косинуса в коде, чем городить вложенные массивы.
model CategoryTerm {
  id String @id @default(uuid())

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  term String

  embedding Float[] @default([])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([categoryId])
  @@map("category_terms")
}

model CategoryFeature {
  id String @id @default(uuid())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  label       String
  description String?

  type FeatureType

  required   Boolean @default(false)
  filterable Boolean @default(true)

  placeholder String?

  // Единица измерения (для type = NUMBER). Раньше была только одна
  // строка unit — этого хватало для полей с фиксированной единицей
  // ("Объём контейнера" -> "л"), но не для полей, где продавец сам
  // выбирает из нескольких вариантов ("Мощность" -> кВт ИЛИ л.с.), и
  // seed.ts такие случаи вообще не сохранял (unit оставался null).
  // units — единственный источник правды на клиенте теперь: первый
  // элемент массива считается канонической единицей (та, в которой
  // значение реально хранится в Ad.features — конвертация из
  // выбранной пользователем единицы происходит на клиенте перед
  // сохранением, см. dynamic-field.tsx), последующие — альтернативы,
  // которые можно выбрать при вводе. unit (старое поле) оставлен для
  // обратной совместимости и не используется новым кодом напрямую.
  unit  String?
  units String[] @default([])

  options Json?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([categoryId, sortOrder])
  @@map("category_features")
}

enum FeatureType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
}

model Ad {
  id          String    @id @default(uuid())
  slug        String    @unique @default("")
  title       String
  description String    @db.Text
  price       BigInt?
  unit        PriceUnit @default(ITEM)
  images      String[]
  address     String
  phone       String
  features    Json      @default("{}")
  lat         Float
  lng         Float

  // Регион объявления — берётся из того же ответа DaData, которым уже
  // геокодируется address/lat/lng (см. AddressInput), без отдельного
  // запроса. region — для отображения ("Кабардино-Балкарская Респ."),
  // regionIsoCode — стабильный ISO 3166-2:RU код (например "RU-KB"),
  // именно по нему фильтруем в каталоге (AdsService.findAll) — он не
  // зависит от вариаций написания названия региона.
  region        String?
  regionIsoCode String? @map("region_iso_code")

  // Более узкий уровень, чем регион — конкретный город ИЛИ (если это не
  // город, а посёлок/село) населённый пункт; из того же DaData-ответа.
  // locality — для отображения ("г. Нальчик" / "с. Верх-Ирмень"),
  // localityFiasId — стабильный ФИАС-идентификатор для точного фильтра
  // (у городов/сёл нет ISO-кода, в отличие от региона).
  locality       String?
  localityFiasId String? @map("locality_fias_id")

  categoryPath String[] @default([]) @map("category_path")
  seoPath      String   @map("seo_path")

  userId String @map("user_id")
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String     @map("category_id")
  category   Category   @relation(fields: [categoryId], references: [id])
  favorites  Favorite[]

  conversations Conversation[]
  reports       AdReport[]
  sellerReports SellerReport[]
  bumps         AdBump[]
  views         AdView[]
  viewsDaily    AdViewDaily[]
  phoneReveals  AdPhoneReveal[]

  status AdStatus @default(PENDING)

  rejectionReason String?   @map("rejection_reason")
  expiresAt       DateTime? @map("expires_at")
  publishedAt     DateTime? @map("published_at")

  // Когда объявление в последний раз ушло в статус ARCHIVED — null, если
  // никогда (или уже вышло из архива обратно). НЕ переиспользуем updatedAt
  // для этого — он сбивается любым другим изменением объявления, а не
  // только уходом в архив. Нужен, чтобы AdsArchivePurgeWorker мог считать
  // "объявление лежит в архиве больше 30 дней" именно от момента архивации,
  // а не от последнего редактирования (см. AdsService.archive/activate/draft/publishDraft
  // и AdsArchivePurgeWorker).
  archivedAt DateTime? @map("archived_at")

  // Время последнего платного "поднятия" объявления (см. AdBumpsService) —
  // null, если ни разу не поднимали. Используется вместо createdAt в
  // сортировке каталога по умолчанию (COALESCE(bumped_at, created_at) —
  // см. AdsService.findAll), чтобы поднятое объявление всплывало в топ
  // ленты ровно как только что созданное, и естественно "тонуло" по мере
  // появления более новых/свежеподнятых объявлений — без отдельного поля
  // "закреплено" и без фоновых задач на снятие закрепления.
  bumpedAt DateTime? @map("bumped_at")

  // До какого момента активна платная услуга "Поднять объявление"
  // (см. AdBumpsService/AdAutoBumpWorker) — null или дата в прошлом, если
  // услуга не куплена/закончилась. Пока это поле в будущем, фоновый воркер
  // раз в сутки сам обновляет bumpedAt — источник истины именно тут, а не
  // в отдельных записях AdBump (та же схема, что и User.premiumUntil vs
  // PremiumPurchase: AdBump — история платежей, bumpServiceUntil — текущее
  // состояние). Повторная покупка ПРОДЛЕВАЕТ это поле (складывает 7 дней
  // поверх текущего значения, если оно ещё не истекло), а не перезаписывает.
  bumpServiceUntil DateTime? @map("bump_service_until")

  // До какого момента активна платная услуга "Выделить цену" — тот же
  // принцип, что у bumpServiceUntil (повторная покупка складывает 7 дней
  // поверх текущего значения, если оно ещё не истекло). В отличие от
  // bumpServiceUntil, фоновому воркеру тут делать нечего — это чисто
  // визуальный флаг, читает его фронт напрямую (AdShortCard/AdDetail),
  // чтобы условно стилизовать цену.
  priceHighlightUntil DateTime? @map("price_highlight_until")

  // Значок на объявлении ("Срочно"/"Торг уместен"/"Новинка", см. AdBadge)
  // и до какого момента он активен. Один активный значок за раз, не
  // массив — сознательно не стали разрешать выбирать несколько сразу (см.
  // обсуждение). Повторная покупка НЕ складывается лесенкой, как у двух
  // услуг выше: если продавец меняет значок, пока старый ещё активен, это
  // просто замена (новые badge + badgeUntil), а не сложение сроков.
  badge      AdBadge?  @map("badge")
  badgeUntil DateTime? @map("badge_until")

  // Комбинированные покупки услуг "Поднять/Выделить цену/Значок" одним
  // платежом — см. AdServicePurchase.
  servicePurchases AdServicePurchase[]

  // Источник объявления — создано вручную через форму (MANUAL, по
  // умолчанию) или импортировано из XML/YML-фида дилера (FEED, см.
  // DealerFeed/DealerFeedSyncService). Для FEED-объявлений заполнены поля
  // ниже; для MANUAL они всегда null.
  source AdSource @default(MANUAL)

  dealerFeedId String?     @map("dealer_feed_id")
  dealerFeed   DealerFeed? @relation(fields: [dealerFeedId], references: [id], onDelete: SetNull)

  // Собственный ID позиции в фиде дилера (тег <Id> в YML) — по нему при
  // повторной синхронизации DealerFeedSyncService понимает "это та же
  // позиция, что и раньше" (обновить) в отличие от новой (создать) или
  // пропавшей из фида (снять с публикации). Уникален в пределах одного
  // фида, не глобально — у разных дилеров ID могут случайно совпадать.
  externalId String? @map("external_id")

  // Карта "ссылка на фото у дилера -> наша ссылка после перезаливки в S3"
  // на момент последней синхронизации (см. DealerFeedSyncService) — чтобы
  // при следующей синхронизации не перекачивать и не перезаливать фото
  // повторно, если ссылка у дилера не изменилась.
  feedSourceImages Json? @map("feed_source_images")

  // Разобранная позиция фида как она пришла от дилера в последний раз —
  // на случай споров/отладки (почему объявление выглядит так, а не иначе,
  // что реально было в фиде). Не участвует ни в какой бизнес-логике.
  feedRawData Json? @map("feed_raw_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dealerFeedId, externalId])
  @@index([status])
  @@index([status, expiresAt])
  // Под AdsArchivePurgeWorker: выборка архивных объявлений живых аккаунтов
  // старше 30 дней (архив удалённых аккаунтов ищется через User.deletedAt).
  @@index([status, archivedAt])
  @@index([userId])
  @@index([categoryId])
  // Под фильтр каталога: выбрана категория + сортировка/диапазон по цене.
  @@index([categoryId, price])
  @@index([phone])
  @@index([regionIsoCode])
  @@index([localityFiasId])
  @@index([dealerFeedId])
  @@map("ads")
}

enum AdSource {
  MANUAL
  FEED
}

// "Срочно" / "Торг уместен" / "Новинка" — только субъективные пометки
// продавца о самой сделке, никогда факты о цене (см. обсуждение, почему
// сюда осознанно не попала "Скидка" — это отдельный автоматический
// признак на основе реальной истории цены, не значок, который можно
// просто купить).
enum AdBadge {
  URGENT
  NEGOTIABLE
  NEW
}

model Favorite {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  adId String @map("ad_id")
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, adId]) // Ограничение: юзер не может добавить одно объявление дважды
  @@index([userId])
  @@index([adId])
  @@map("favorites")
}

enum AdReportReason {
  SCAM
  WRONG_CATEGORY
  PROHIBITED_ITEM
  DUPLICATE
  SPAM
  OTHER
}

// PENDING — ещё не разобрана модератором; REVIEWED — разобрана, меры приняты
// (например, объявление отклонено отдельным действием в очереди модерации);
// DISMISSED — разобрана и признана необоснованной. Порядок значений важен:
// используется для сортировки "новые жалобы сверху" (см. AdReportsService.findAll).
enum AdReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

// Жалоба на объявление — модерация контента (не то же самое, что
// блокировка юзера в чате, см. BlockedUser: там про отношения между двумя
// людьми, здесь про сам контент объявления, и жалоба должна быть видна
// модератору вне зависимости от того, переписывался ли жалующийся с
// продавцом). Одна жалоба от одного юзера на одно объявление — чтобы нельзя
// было накрутить счётчик жалоб самому себе спамом кликов.
model AdReport {
  id String @id @default(uuid())

  adId String @map("ad_id")
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason  AdReportReason
  comment String?        @db.Text
  status  AdReportStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([adId, userId])
  @@index([adId])
  @@index([userId])
  @@index([status])
  @@map("ad_reports")
}

// PENDING — платёж создан в ЮKassa, ждём подтверждения по вебхуку;
// SUCCEEDED — оплата прошла, объявление поднято (Ad.bumpedAt проставлен
// в той же транзакции — см. AdBumpsService.handleWebhook); CANCELED —
// платёж отменён/просрочен на стороне ЮKassa. Статус выставляется только
// на основании повторного запроса к API ЮKassa по platformId, а не на
// основании тела вебхука (его в теории можно подделать).
enum AdBumpStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

// Один платный "разовый подъём" объявления в топ ленты. Каждая попытка —
// отдельная запись (в отличие от AdReport с @@unique — тут юзер может
// поднимать одно и то же объявление сколько угодно раз, было бы за что
// платить).
model AdBump {
  id String @id @default(uuid())

  adId String @map("ad_id")
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // В копейках — как и Ad.price устроен через BigInt, чтобы не иметь дела
  // с плавающей точкой в деньгах. Для ЮKassa конвертируется в строку с
  // двумя знаками после запятой (см. AdBumpsService).
  amount Int

  status AdBumpStatus @default(PENDING)

  // id платежа в ЮKassa — приходит в ответ на создание платежа, по нему же
  // сверяем вебхук. Уникален — на один AdBump не может быть двух платежей
  // ЮKassa одновременно.
  yookassaPaymentId String? @unique @map("yookassa_payment_id")

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  @@index([adId])
  @@index([userId])
  @@index([status])
  @@map("ad_bumps")
}

// Статистика просмотров — приватная, видит только владелец объявления и
// админ (см. AdsService.getViewStatsForOwner/getViewStatsForAdmin), поэтому
// не денормализуем счётчик прямо на Ad — читается редко, писать на каждый
// публичный просмотр в саму широкую таблицу Ad было бы гораздо дороже (у
// каждого UPDATE там пришлось бы переписывать всю строку с текстовыми
// полями объявления, и это лишняя блокировка на самом горячем публичном
// эндпоинте — см. AdsService.findOne).
//
// AdView — сырые события, максимум сутки данных: один посетитель считается
// один раз в день (@@unique), AdViewsRollupWorker каждую ночь сворачивает
// вчерашние строки в AdViewDaily и удаляет их отсюда — таблица никогда не
// растёт бесконечно.
model AdView {
  id String @id @default(uuid())

  adId String @map("ad_id")
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)

  // "user:{id}" для залогиненных, "anon:{sha256(ip+ua)}" для анонимов —
  // сырой IP не храним (персональные данные, 152-ФЗ), хэша достаточно для
  // дедупа (см. computeViewerKey в ads/utils/viewer-key.util.ts). Сам
  // владелец объявления в эту таблицу не попадает вовсе — не считаем
  // просмотром, когда он смотрит своё же объявление (см. AdsService.findOne).
  viewerKey String @map("viewer_key")

  // Без времени — только день, ради дедупа "один посетитель — один
  // засчитанный просмотр в сутки".
  viewDate DateTime @map("view_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([adId, viewerKey, viewDate])
  @@index([viewDate])
  @@map("ad_views")
}

// Свёрнутые дневные суммы — постоянное хранилище статистики (в отличие от
// AdView). Максимум одна строка на объявление в день, живёт вместе с
// объявлением (Cascade) — отдельно чистить не нужно, всё уйдёт само при
// физическом удалении объявления (см. AdsArchivePurgeWorker).
model AdViewDaily {
  id String @id @default(uuid())

  adId String @map("ad_id")
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  views Int      @default(0)

  @@unique([adId, date])
  @@map("ad_views_daily")
}

enum PremiumPurchaseStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

// Разовая покупка премиум-статуса на 30 дней (см. User.premiumUntil) — по
// структуре и логике оплаты почти copy-paste AdBump: тот же одноразовый
// чекаут в ЮKassa, та же перепроверка статуса вместо доверия вебхуку.
// Отличие от AdBump — это не привязано к конкретному объявлению (платит
// сам юзер за себя), и продление СКЛАДЫВАЕТ дни поверх текущего
// premiumUntil, а не перезаписывает его (см. PremiumService.reconcilePayment).
//
// isRecurring/yookassaPaymentMethodId — задел под будущее автосписание:
// ЮKassa подтвердила, что рекуррентные платежи для магазина доступны на
// проде, но не в тестовом режиме, поэтому сам код автосписания пока не
// пишем (не на чем проверить) — просто резервируем под него поля, чтобы
// не переделывать схему, когда дойдём до этого на проде.
model PremiumPurchase {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // В копейках, как и AdBump.amount.
  amount Int

  status PremiumPurchaseStatus @default(PENDING)

  yookassaPaymentId String? @unique @map("yookassa_payment_id")

  isRecurring             Boolean @default(false) @map("is_recurring")
  yookassaPaymentMethodId String? @map("yookassa_payment_method_id")

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  @@index([userId])
  @@index([status])
  @@map("premium_purchases")
}

enum AdServiceType {
  BUMP
  PRICE_HIGHLIGHT
  BADGE
}

enum AdServicePurchaseStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

// Единая страница "Поднять просмотры" (см. AdServicesService) — продавец
// выбирает переключателями любой набор из трёх услуг (поднятие, выделение
// цены, значок) и платит ОДНИМ платежом за всё выбранное, а не отдельно
// за каждую. services — какие услуги входят в эту покупку ('BUMP' |
// 'PRICE_HIGHLIGHT' | 'BADGE'), badge — какой именно значок выбран, если
// 'BADGE' среди services (иначе null).
//
// Специально НЕ переиспользует AdBump/его таблицу — тот остаётся
// самостоятельным для случаев точечной покупки одного поднятия (см.
// AdBumpsService), а тут именно "пакет" из произвольного набора услуг.
// AdServicesService.reconcilePayment при успехе применяет эффект каждой
// услуги из массива к соответствующему полю Ad (bumpServiceUntil /
// priceHighlightUntil / badge+badgeUntil) в одной транзакции — та же
// логика продления "лесенкой", что и в AdBumpsService/PremiumService.
model AdServicePurchase {
  id String @id @default(uuid())

  adId String @map("ad_id")
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // В копейках, как и AdBump.amount — сумма ВСЕХ выбранных услуг разом,
  // считается на сервере из AD_SERVICE_PRICES_KOPECKS (см. константы),
  // никогда не принимается от клиента.
  amount Int

  services AdServiceType[]

  badge AdBadge?

  status AdServicePurchaseStatus @default(PENDING)

  yookassaPaymentId String? @unique @map("yookassa_payment_id")

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  @@index([adId])
  @@index([userId])
  @@index([status])
  @@map("ad_service_purchases")
}

enum DealerFeedStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Тарифные планы дилерского фида — по объёму позиций, а не единая ставка,
// как у обычного "Премиум" (см. обсуждение с владельцем: аудитория и
// ценность принципиально другие — не буст своего объявления, а массовый
// автоматический импорт целого каталога, следовательно и платить дилер
// должен за объём, а не по единой ставке для всех). Ровно так же построена
// платная "Авито Автозагрузка" — доступна только на бизнес-тарифе, а не в
// личном "бусте" объявлений.
enum DealerTier {
  UP_TO_20
  UP_TO_100
  UNLIMITED
}

// Один дилерский фид на аккаунт (userId уникален) — сознательно не
// массив: сценарий "один дилер — несколько разных фидов" пока не
// встречался и усложнил бы и модель, и личный кабинет (см. обсуждение
// UI — раздел "Фиды" в /profile/settings как один экран статуса, а не
// список). Если понадобится несколько фидов на дилера — снять @unique
// с userId будет достаточно, остальная модель не изменится.
model DealerFeed {
  id String @id @default(uuid())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url String

  // Массовый импорт — потенциальный вектор спама/мошенничества (см.
  // обсуждение с владельцем), поэтому первое подключение фида требует
  // ручного одобрения администратором, прежде чем DealerFeedSyncWorker
  // начнёт что-либо импортировать по этой ссылке. rejectionReason — текст
  // для дилера, почему отклонили (виден ему в личном кабинете).
  status          DealerFeedStatus @default(PENDING_REVIEW)
  rejectionReason String?          @map("rejection_reason")
  reviewedAt      DateTime?        @map("reviewed_at")
  reviewedBy      String?          @map("reviewed_by")

  // Дилер сам может приостановить синхронизацию, не разрывая подключение
  // (не нужно заново проходить модерацию, чтобы возобновить) — отдельно
  // от status, который отражает решение админа, а не желание дилера.
  isPaused Boolean @default(false) @map("is_paused")

  // Текущее состояние платного тарифа — тот же принцип, что и
  // User.premiumUntil vs PremiumPurchase (см. там): DealerSubscription —
  // история платежей, эти два поля — текущее состояние, которое реально
  // читает DealerFeedSyncService перед импортом (сколько позиций максимум
  // разрешено активному тарифу).
  subscriptionTier  DealerTier? @map("subscription_tier")
  subscriptionUntil DateTime?   @map("subscription_until")

  // Итоги последней синхронизации — чтобы дилер в личном кабинете видел не
  // просто "синхронизировано", а что конкретно произошло (см.
  // DealerFeedSyncService.syncOne), и чтобы админ мог разобраться в
  // проблемном фиде, не читая логи контейнера.
  lastSyncAt            DateTime? @map("last_sync_at")
  lastSyncError         String?   @map("last_sync_error") @db.Text
  lastSyncItemsTotal    Int?      @map("last_sync_items_total")
  lastSyncItemsCreated  Int?      @map("last_sync_items_created")
  lastSyncItemsUpdated  Int?      @map("last_sync_items_updated")
  lastSyncItemsRemoved  Int?      @map("last_sync_items_removed")
  lastSyncItemsFailed   Int?      @map("last_sync_items_failed")
  // Список ошибок по конкретным позициям ([{externalId, title, reason}]) —
  // отдельно от lastSyncError (который про фид целиком: недоступен урл,
  // невалидный XML и т.п.), см. комментарий в DealerFeedSyncService.
  lastSyncItemErrors    Json?     @map("last_sync_item_errors")

  subscriptions DealerSubscription[]
  ads           Ad[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("dealer_feeds")
}

enum DealerSubscriptionStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

// Разовая покупка дилерского тарифа на PREMIUM_DURATION_DAYS-подобный срок
// (см. константы в dealer-feeds/constants) — по структуре и логике оплаты
// такой же чекаут в ЮKassa, как AdBump/PremiumPurchase/AdServicePurchase
// (см. подробные комментарии там), намеренно не переиспользует ни одну из
// них — это независимый вид платежа с собственным смыслом (тариф на
// фид), а не услуга на конкретное объявление и не буст аккаунта.
model DealerSubscription {
  id String @id @default(uuid())

  dealerFeedId String     @map("dealer_feed_id")
  dealerFeed   DealerFeed @relation(fields: [dealerFeedId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier DealerTier

  // В копейках, как и AdBump.amount/PremiumPurchase.amount.
  amount Int

  status            DealerSubscriptionStatus @default(PENDING)
  yookassaPaymentId String?                  @unique @map("yookassa_payment_id")

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  @@index([dealerFeedId])
  @@index([userId])
  @@index([status])
  @@map("dealer_subscriptions")
}

// Диалог между покупателем и продавцом ПО КОНКРЕТНОМУ объявлению — не
// просто "переписка между двумя юзерами", а именно пара (объявление,
// покупатель): если один и тот же человек напишет продавцу и про трактор, и
// через месяц про комбайн — это два разных диалога, а не одна общая каша
// сообщений. sellerId продублирован из ad.userId (а не вычисляется каждый
// раз через join) — чтобы дёшево фильтровать "мои диалоги как продавец" по
// индексу, без обращения к Ad.
//
// Курсоры прочтения (buyerLastReadAt/sellerLastReadAt) — вместо флага
// "прочитано" на каждом отдельном Message: непрочитанные считаются
// сравнением lastMessageAt с *LastReadAt соответствующей стороны, что не
// требует ни отдельной таблицы статусов чтения, ни массового UPDATE по всем
// сообщениям диалога при открытии чата — обновляется одна строка.
//
// dealConfirmedAt — отметка "сделка состоялась": её ставит ПРОДАВЕЦ кнопкой
// в чате (ConversationsService.setDealConfirmed), null — не отмечена. Диалог
// по объявлению всегда один на пару "покупатель — объявление", так что
// отметка привязана к конкретному покупателю. Основа системы отзывов:
// отзыв после подтверждённой сделки имеет полный вес, а отзыв по простому
// контакту — меньший (см. claude/seller-ratings-plan.md).
//
// type различает два физически разных сценария в одной таблице:
//   AD      — обычный диалог покупатель/продавец по объявлению, как описано
//             выше. buyerId и sellerId обязательны, guestId всегда null.
//   SUPPORT — диалог с поддержкой (см. SupportChatWidget). adId и sellerId
//             всегда null — отвечать может ЛЮБОЙ пользователь с ролью ADMIN
//             (проверяется по роли в ConversationsService, а не по
//             конкретному sellerId), это осознанно: если админов станет
//             больше одного, тикет не придётся никому "переприсваивать".
//             Второй участник — buyerId (залогиненный юзер) ИЛИ guestId
//             (анонимный посетитель, см. SupportGuest), но не оба сразу и
//             не ни один — это гарантируется CHECK-constraint'ом
//             conversation_participant_check, добавленным вручную поверх
//             сгенерированной Prisma-миграции (см. миграцию
//             add_support_chat) — сам Prisma такие условные constraint'ы
//             не умеет выразить в schema.prisma.
model Conversation {
  id String @id @default(uuid())

  type ConversationType @default(AD)

  // Nullable + SetNull (не Cascade) — сознательно: объявление может быть
  // физически удалено (см. AdsArchivePurgeWorker) НЕЗАВИСИМО от судьбы
  // переписки по нему. Раньше здесь был Cascade, и удаление объявления
  // сносило переписку целиком — в том числе у собеседника, который ничего
  // не удалял и не мог на это повлиять. adTitleSnapshot хранит заголовок на
  // момент создания диалога, чтобы после удаления объявления в интерфейсе
  // не было пустоты (см. ConversationsService.startConversation). Для
  // SUPPORT-диалогов всегда null.
  adId String? @map("ad_id")
  ad   Ad?     @relation(fields: [adId], references: [id], onDelete: SetNull)

  adTitleSnapshot String? @map("ad_title_snapshot")

  // Nullable — для SUPPORT-диалога с анонимным гостем buyerId пуст, вместо
  // него заполнен guestId (см. type выше и CHECK-constraint в миграции). Для
  // AD-диалогов и для SUPPORT-диалогов залогиненного пользователя buyerId
  // обязателен.
  buyerId String? @map("buyer_id")
  buyer   User?   @relation("ConversationsAsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  // Анонимный собеседник в SUPPORT-диалоге — см. SupportGuest. onDelete:
  // Cascade тут не страшен: SupportGuest не удаляется физически (см.
  // комментарий к модели), значит и диалог с ним не пропадёт неожиданно.
  guestId String?       @map("guest_id")
  guest   SupportGuest? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  // Только для AD-диалогов — см. type. Для SUPPORT всегда null: отвечающий
  // определяется ролью, а не привязкой к конкретному аккаунту.
  sellerId String? @map("seller_id")
  seller   User?   @relation("ConversationsAsSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  messages Message[]

  chatEmailReminders ChatEmailReminder[]

  // Отзывы, оставленные покупателем по этому диалогу (см. SellerReview).
  sellerReviews SellerReview[]

  lastMessageAt DateTime? @map("last_message_at")

  buyerLastReadAt  DateTime? @map("buyer_last_read_at")
  sellerLastReadAt DateTime? @map("seller_last_read_at")

  dealConfirmedAt DateTime? @map("deal_confirmed_at")

  // "Удаление" диалога — per-user, не физическое: переписка принадлежит
  // ОБОИМ участникам, и стереть её из базы по воле одного из них означало
  // бы стереть историю и у второго. Поэтому "удалить" — это скрыть у себя;
  // диалог продолжает существовать и просто пропадает из списка того, кто
  // его скрыл (см. ConversationsService.deleteConversation). Если после
  // этого приходит новое сообщение — оба флага сбрасываются обратно в
  // false (см. createMessage): диалог не должен быть потерян навсегда для
  // человека, которому продолжают писать.
  hiddenByBuyer  Boolean @default(false) @map("hidden_by_buyer")
  hiddenBySeller Boolean @default(false) @map("hidden_by_seller")

  // Когда участник нажал «Удалить переписку»: он видит только сообщения
  // новее этой отметки (для него история начинается с чистого листа, даже если
  // собеседник потом напишет снова и диалог вернётся в список). У собеседника
  // история остаётся целиком. Отметка остаётся и после возвращения диалога.
  buyerClearedAt  DateTime? @map("buyer_cleared_at")
  sellerClearedAt DateTime? @map("seller_cleared_at")

  // Диалог физически удаляется (не скрывается) целиком, когда ОБА участника
  // уже удалили свои аккаунты — тогда он гарантированно бесхозный: ни один
  // из них не сможет в него зайти (AuthGuard отклоняет юзеров с deletedAt).
  // Пока жив хотя бы один — диалог остаётся как есть, это его личная
  // история переписки, второй показывается с обезличенным профилем и
  // соответствующей подписью в интерфейсе (см. UserService.deleteAccount).
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Повторное обращение того же покупателя по тому же объявлению должно
  // попадать в существующий диалог, а не плодить дубликаты. Для SUPPORT
  // (adId всегда null) это ограничение по одному только adId ничего не
  // дедуплицирует — "один активный тикет на покупателя/гостя" гарантируют
  // отдельные частичные уникальные индексы (conversation_support_buyer_unique
  // / conversation_support_guest_unique), добавленные вручную в миграции:
  // Prisma не умеет выразить partial unique index (WHERE type = 'SUPPORT')
  // прямо в schema.prisma.
  @@unique([adId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@index([adId])
  @@index([guestId])
  @@index([type, lastMessageAt])
  @@map("conversations")
}

// Блокировка одного юзера другим — глобальная, не привязанная к конкретному
// диалогу или объявлению: если заблокировал, значит не хочет получать
// сообщения от этого человека вообще, а не только в рамках одной переписки
// (в отличие от "удаления" диалога, см. Conversation.hiddenByBuyer/hiddenBySeller,
// которое скрывает только конкретную переписку и снимается новым сообщением).
// Однонаправленная запись (blocker -> blocked), но проверка при отправке
// сообщения смотрит блокировку в обе стороны — если хотя бы один из двух
// заблокировал другого, переписка невозможна (см. BlockedUsersService.isBlocked).
model BlockedUser {
  id String @id @default(uuid())

  blockerId String @map("blocker_id")
  blocker   User   @relation("BlockerOf", fields: [blockerId], references: [id], onDelete: Cascade)

  blockedId String @map("blocked_id")
  blocked   User   @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocked_users")
}

model Message {
  id String @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Nullable по той же причине, что buyerId/guestId у Conversation —
  // отправитель либо зарегистрированный User, либо анонимный SupportGuest,
  // но не оба сразу и не ни один (CHECK-constraint message_sender_check,
  // добавлен вручную в миграции add_support_chat).
  senderId String? @map("sender_id")
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  senderGuestId String?       @map("sender_guest_id")
  senderGuest   SupportGuest? @relation(fields: [senderGuestId], references: [id], onDelete: Cascade)

  text        String   @db.Text
  attachments String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")

  // Soft-delete, сейчас — только для SUPPORT (см. SupportService.deleteMessage):
  // админ может удалить любое сообщение тикета, своё или собеседника, и оно
  // пропадает из выдачи ОБЕИХ сторон. Физически строка не стирается —
  // deletedAt просто исключает её из getMessages/getAdminConversations —
  // это дешевле и безопаснее хард-делита: не ломает lastMessageAt/
  // isFirstMessage соседних сообщений, и оставляет след на случай спора
  // задним числом, даже если наружу (в API) он никогда не показывается.
  deletedAt DateTime? @map("deleted_at")

  // Под пагинированную историю диалога, отсортированную по времени.
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([senderGuestId])
  @@map("messages")
}

// Анонимный посетитель, написавший в чат поддержки без логина (см.
// SupportChatWidget). Намеренно НЕ строка в User: заводить фейковый
// аккаунт на каждого анонима означало бы засорять таблицу пользователей и
// портить любую аналитику по реальным юзерам.
//
// Идентификация — через обычную express-session (см. main.ts: session на
// Redis, cookie ставится только когда что-то реально записано в
// req.session — saveUninitialized: false), а не через отдельный токен:
// в req.session.supportGuestId лежит id этой записи, cookie подписана
// SESSION_SECRET, подделать нельзя — заводить для той же цели ещё одну
// параллельную сущность "токен" было бы просто дублированием того, что уже
// даёт сессия бесплатно.
//
// Если гость затем регистрируется или логинится — его SUPPORT-диалог
// "приклеивается" к новому аккаунту: guestId в Conversation/Message
// заменяется на buyerId/senderId этого юзера (см.
// ConversationsService.mergeGuestOnLogin), а сама запись SupportGuest не
// удаляется и остаётся привязана через mergedIntoUserId — просто как
// исторический след, по которому больше ничего не ищется.
model SupportGuest {
  id String @id @default(uuid())

  // Для базового антиспама и чтобы админ мог забанить конкретного гостя
  // (см. SupportGuestsService.block) — не для аналитики.
  ip        String? @map("ip")
  userAgent String? @map("user_agent")

  // Бан ставит админ прямо из чата (аналог BlockedUser, но гость — не User,
  // и блокировка тут однонаправленная и не требует отдельной таблицы: у
  // гостя просто нет своего аккаунта, откуда он мог бы "заблокировать в
  // ответ"). Заблокированный гость получает 403 при попытке отправить
  // сообщение — весь его диалог при этом никуда не девается, админ может
  // читать историю.
  blockedAt DateTime? @map("blocked_at")

  conversations Conversation[]
  messages      Message[]

  mergedIntoUserId String? @map("merged_into_user_id")
  mergedIntoUser   User?   @relation(fields: [mergedIntoUserId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @updatedAt @map("last_seen_at")

  @@index([mergedIntoUserId])
  @@map("support_guests")
}

enum UserRole {
  REGULAR
  ADMIN
  PREMIUM
}

enum UserType {
  INDIVIDUAL
  INDIVIDUAL_ENTREPRENEUR
  BUSINESS
}

enum AuthMethod {
  CREDENTIALS
  GOOGLE
  YANDEX
}

enum TokenType {
  VERIFICATION
  TWO_FACTOR
  PASSWORD_RESET
  EMAIL_CHANGE
  SMS_VERIFICATION
  PHONE_CHANGE
}

enum AdStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
  EXPIRED
  // Приостановлено до решения модератора: на продавца пожаловались несколько
  // независимых людей (см. SellerReport). Покупателям не видно, владелец не
  // может ни снять, ни удалить объявление — оно остаётся как материал для
  // проверки. Решение модератора возвращает его в PUBLISHED (или EXPIRED,
  // если срок публикации уже вышел).
  SUSPENDED
}

enum ConversationType {
  AD
  SUPPORT
}

// Статический справочник городов России (датасет hflabs/city, тот же
// источник, что и DaData) — импортируется один раз сид-скриптом
// (prisma/seed.ts, prisma/data/ru-cities.ts) и НЕ зависит от того, есть ли
// по этому городу хотя бы одно объявление. Нужен, чтобы фильтр локации в
// каталоге подсказывал города сразу при вводе (см. AdsService.getAvailableLocations).
// Сёл/деревень тут нет (в исходном датасете их нет) — они по-прежнему
// фильтруются только по реальным объявлениям, как и раньше.
model RuCity {
  fiasId String @id @map("fias_id")

  city     String
  cityType String? @map("city_type")

  region     String
  regionType String? @map("region_type")

  // Москва/Санкт-Петербург/Севастополь — у них city совпадает с region;
  // используется в AdsService для матчинга объявлений по названию региона
  // (ISO-код региона мы намеренно не хардкодим — см. комментарий в
  // ru-cities.ts).
  isFederalCity Boolean @default(false) @map("is_federal_city")

  lat Float
  lng Float

  @@index([city])
  @@map("ru_cities")
}

enum PriceUnit {
  ITEM
  TON
  KG
  LITER
  M3
  BAG
  HEAD
  DOSE
  RUNNING_METER
  HA
  HOUR
}

// Уведомление юзеру про событие, которое ему стоит увидеть, даже если он
// сам не зайдёт целенаправленно проверять (см. обсуждение — раньше
// отклонение объявления модератором было видно ТОЛЬКО если продавец сам
// откроет "Мои объявления"). Сущность универсальная (не "AdRejection..."),
// чтобы под новые события (одобрили объявление, истекает премиум и т.п.)
// не заводить отдельную таблицу каждый раз — достаточно добавить значение
// в NotificationType.
model Notification {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  // Куда ведёт клик по уведомлению (например /ads/{id}/edit для
  // отклонённого объявления) — опционально, не все уведомления обязаны
  // куда-то вести.
  link String?

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  AD_REJECTED
  // Новое сообщение в диалоге по объявлению (см. ConversationsService) —
  // раньше получатель никак не узнавал о нём, кроме как сам зайдёт в "Мои
  // сообщения" и заметит (см. обсуждение с владельцем).
  NEW_MESSAGE
  // Отзыв автора скрыт модератором (по жалобам или после проверки).
  SELLER_REVIEW_HIDDEN
  // Отзыв, задержанный на проверку, одобрен и опубликован.
  SELLER_REVIEW_PUBLISHED
  // Предупреждение продавцу по жалобам на него.
  SELLER_WARNING
  // Объявления продавца приостановлены до проверки жалоб.
  SELLER_ADS_SUSPENDED
  // Проверка завершилась, объявления снова опубликованы.
  SELLER_ADS_RESTORED
  // Продавцу: о нём появился новый опубликованный отзыв.
  SELLER_REVIEW_RECEIVED
  // Автору отзыва: продавец ответил на его отзыв.
  SELLER_REVIEW_REPLIED
  // Покупателю: продавец отметил сделку состоявшейся — можно оценить его.
  SELLER_DEAL_CONFIRMED
}

enum RegistrationChannel {
  PHONE
  EMAIL
}

enum RegistrationPlatform {
  SITE
  APP
  UNKNOWN
}

enum RegistrationAttemptStatus {
  IN_PROGRESS
  FAILED
  COMPLETED
}

// До какого шага дошла попытка: STARTED — только ввели данные,
// CONFIRMATION_SENT — человеку выдан номер для звонка или отправлено письмо,
// COMPLETED — регистрация завершена.
enum RegistrationAttemptStep {
  STARTED
  CONFIRMATION_SENT
  COMPLETED
}

enum RegistrationFailureReason {
  ALREADY_REGISTERED
  PROVIDER_ERROR
  CODE_INVALID
  CODE_EXPIRED
  CALL_NOT_RECEIVED
  LINK_EXPIRED
  INVALID_DATA
  UNKNOWN_ERROR
}

// Магазин, через который доставляется push на устройство. FCM (Google) —
// когда появится, добавится вторым значением.
enum PushProvider {
  RUSTORE
  // Google Firebase Cloud Messaging: быстрая доставка на Android с сервисами Google.
  FCM
}

// Устройство пользователя, на которое можно отправить push (по одной записи на
// токен). Один человек — несколько устройств; токен принадлежит устройству, а
// не аккаунту: после выхода и входа под другим аккаунтом он переходит к новому
// владельцу (см. PushService.registerDevice).
model PushDevice {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider PushProvider
  token    String

  appVersion String? @map("app_version")

  // Идентификатор установки приложения (создаётся на телефоне). По нему на одном
  // телефоне остаётся один канал: при регистрации FCM токен RuStore этой же
  // установки удаляется, иначе пуш пришёл бы дважды.
  installationId String? @map("installation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, token])
  @@index([userId])
  @@index([installationId])
  @@map("push_devices")
}

// Отложенное письмо о новом сообщении в чате: «через CHAT_EMAIL_DELAY_MS
// проверить, прочитал ли получатель, и если нет — написать ему на почту».
// Строка создаётся на первое непрочитанное сообщение диалога для получателя и
// удаляется воркером в момент отправки (или решения не отправлять), поэтому
// таблица всегда короткая. Уникальность по (диалог, получатель) не даёт
// плодить напоминания на каждое сообщение серии.
model ChatEmailReminder {
  id String @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  recipientId String @map("recipient_id")
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  dueAt     DateTime @map("due_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([conversationId, recipientId])
  @@index([dueAt])
  @@map("chat_email_reminders")
}
